{
  "name": "@chronoverse-toolkit/commitlint",
  "version": "0.0.1",
  "description": "Fully typed commitlint configuration for Nx monorepos with emoji support and custom scope resolution.",
  "keywords": [
    "commitlint",
    "nx",
    "monorepo",
    "conventional-commits",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gratisvictory/chronoverse-toolkit"
  },
  "license": "MIT",
  "author": {
    "name": "gratisvictory",
    "email": "gratisvictory@gmail.com",
    "url": "https://github.com/gratisvictory"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/@types/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/@types/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn build:clean && tsdown",
    "build:clean": "rimraf dist",
    "check-types": "tsc -p ./tsconfig.lib.json --noEmit",
    "clean": "rimraf node_modules",
    "clean:all": "rimraf dist node_modules",
    "format:check": "prettier -c . --config ../../../prettier.config.js",
    "format:check:cache": "prettier -c . --config ../../../prettier.config.js --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "prettier -w . --config ../../../prettier.config.js --log-level=warn",
    "format:fix:cache": "prettier -w . --config ../../../prettier.config.js --cache --cache-location node_modules/.cache/.prettiercache --log-level=warn"
  },
  "dependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@commitlint/cz-commitlint": "^20.2.0",
    "@nx/devkit": "^22.2.3",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "inquirer": "^13.1.0"
  },
  "devDependencies": {
    "@commitlint/types": "^20.2.0",
    "@types/node": "^24.10.3",
    "es-toolkit": "^1.43.0",
    "glob": "^13.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "tsdown": "^0.17.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.12.0",
  "publishConfig": {
    "access": "public"
  }
}
