{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "690cedc204fe72bfe84bb069",
  "release": {
    "projects": ["packages/**/*"],
    "projectsRelationship": "independent",
    "changelog": {
      "projectChangelogs": false,
      "workspaceChangelog": {
        "file": false,
        "createRelease": "github"
      }
    },
    "version": {
      "conventionalCommits": true
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "check-types": {
      "cache": true
    },
    "format:check": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "lint:check": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "dependsOn": ["build"]
    }
  }
}
