{
  "name": "@chronoverse-toolkit/prettier",
  "version": "0.0.0",
  "description": "Opinionated Prettier configuration for Chronoverse projects with automatic plugin detection and type-safe configuration.",
  "keywords": [
    "chronoverse:prettier",
    "chronoverse:prettier-config",
    "chronoverse:formatting",
    "chronoverse:code-quality",
    "chronoverse:typescript",
    "chronoverse:prettier-plugin",
    "chronoverse:monorepo",
    "chronoverse:config",
    "chronoverse:code-style"
  ],
  "homepage": "https://github.com/gratisvictory/chronoverse-toolkit/tree/main/packages/formatting/prettier#readme",
  "bugs": {
    "url": "https://github.com/gratisvictory/chronoverse-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gratisvictory/chronoverse-toolkit",
    "directory": "packages/formatting/prettier"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gratisvictory"
  },
  "license": "MIT",
  "author": {
    "name": "gratisvictory",
    "email": "gratisvictory@gmail.com",
    "url": "https://github.com/gratisvictory"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/@types/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/@types/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn build:clean && tsdown",
    "build:clean": "rimraf dist",
    "check-types": "tsc -p ./tsconfig.lib.json --noEmit",
    "clean": "rimraf node_modules",
    "clean:all": "rimraf dist node_modules",
    "format:check": "prettier -c . --config ../../../prettier.config.ts",
    "format:check:cache": "prettier -c . --config ../../../prettier.config.ts --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "prettier -w . --config ../../../prettier.config.ts --log-level=warn",
    "format:fix:cache": "prettier -w . --config ../../../prettier.config.ts --cache --cache-location node_modules/.cache/.prettiercache --log-level=warn",
    "lint:check": "eslint -c ../../../eslint.config.ts",
    "lint:check:cache": "eslint -c ../../../eslint.config.js --cache --cache-location=node_modules/.cache/.eslintcache",
    "lint:fix": "eslint -c ../../../eslint.config.js --fix",
    "lint:fix:cache": "eslint -c ../../../eslint.config.js --cache --cache-location=node_modules/.cache/.eslintcache"
  },
  "dependencies": {
    "local-pkg": "^1.1.2",
    "prettier": "^3.7.4",
    "prettier-plugin-multiline-arrays": "^4.1.3",
    "prettier-plugin-packagejson": "^2.5.20",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@chronoverse-toolkit/types": "workspace:^",
    "@chronoverse-toolkit/utils": "workspace:^",
    "@types/node": "^24.10.4",
    "es-toolkit": "^1.43.0",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "jiti": "^2.6.1",
    "rimraf": "^6.1.2",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "prettier": ">=3.7.4"
  },
  "packageManager": "yarn@4.12.0",
  "publishConfig": {
    "access": "public"
  }
}
