{
  "name": "chronoverse-toolkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "format:check": "nx run-many -t format:check",
    "format:check:all": "prettier -c .",
    "format:check:cache": "nx run-many -t format:check:cache",
    "format:check:cache:all": "prettier -c . --cache",
    "format:fix": "nx run-many -t format:fix",
    "format:fix:all": "prettier -w . --log-level=warn",
    "format:fix:cache": "nx run-many -t format:fix:cache",
    "format:fix:cache:all": "prettier -w . --cache --log-level=warn",
    "lint:ws": "yarn dlx sherif@latest",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/config-nx-scopes": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@nx/js": "^22.1.2",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "inquirer": "^13.0.1",
    "lint-staged": "^16.2.7",
    "nx": "22.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-multiline-arrays": "^4.0.3",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-sort-json": "^4.1.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.12.0"
}
